# ==============================================================================
# Vignan's ResolveHub - Backend Environment Configuration (.env.example)
# ==============================================================================

PORT=3001
NODE_ENV=development

# JWT Secret Configuration
JWT_SECRET=vignan_resolvehub_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Default SuperAdmin Credentials
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=SuperAdmin@2026

# Database Configuration (Optional MongoDB URI; falls back to embedded atomic JSONDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/resolvehub?retryWrites=true&w=majority

# AI Engine Key (Optional)
AI_API_KEY=your_gemini_or_openai_api_key_here
