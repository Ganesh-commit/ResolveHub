# ==============================================================================
# Vignan's ResolveHub - Environment Configuration Template (.env.example)
# Copy this file to .env or server/.env and replace placeholders with real values.
# ==============================================================================

# Server Environment & Port
PORT=3001
NODE_ENV=development

# Authentication & Security
JWT_SECRET=vignan_resolvehub_secure_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Default SuperAdmin Credentials (Provisioned on initial launch)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=SuperAdmin@2026

# Database Configuration (Optional MongoDB URI; falls back to embedded atomic JSONDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/resolvehub?retryWrites=true&w=majority

# AI & LLM Copilot Configuration (Optional for Cloud LLM integration)
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# Frontend Client Configuration (Vite)
VITE_API_URL=http://localhost:3001/api/v1
VITE_SOCKET_URL=http://localhost:3001
